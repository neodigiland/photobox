---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Printing" hideOverflow={false}>
    <div class="min-h-screen w-full flex flex-col items-center justify-center relative select-none py-6">

        <!-- Printer Animation -->
        <div class="relative w-64 h-72 flex flex-col items-center justify-end mb-12" id="printer-visual">
            <!-- Photo paper sliding out -->
            <div id="photo-paper" class="absolute top-0 w-48 h-64 bg-white/10 rounded-sm border border-zinc-700 overflow-hidden transform -translate-y-full flex flex-col p-2 gap-2" style="transition: transform 4s ease-in-out;">
                <div class="flex-1 bg-zinc-700 rounded-sm"></div>
                <div class="flex-1 bg-zinc-700 rounded-sm"></div>
                <div class="flex-1 bg-zinc-700 rounded-sm"></div>
                <div class="h-5 bg-transparent"></div>
            </div>

            <!-- Printer body -->
            <div class="w-64 h-14 bg-zinc-800 rounded-t-xl z-10 border-t border-x border-zinc-700 flex justify-center items-end pb-2 shadow-[0_-15px_30px_rgba(0,0,0,0.5)]">
                <div class="w-52 h-2 bg-black rounded-full shadow-inner"></div>
            </div>
            <div class="w-72 h-12 bg-zinc-900 rounded-lg z-20 shadow-xl border border-zinc-800 flex items-center justify-between px-6">
                <div class="flex gap-2">
                    <div id="printer-led" class="w-3 h-3 rounded-full bg-green-500 animate-pulse shadow-[0_0_10px_#22c55e]"></div>
                    <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
                </div>
                <div class="font-mono text-xs text-zinc-500">PHOTOBOX-PRT</div>
            </div>
        </div>

        <h1 class="text-5xl font-bold mb-5 text-center z-10" id="print-title">Printing Your Memories</h1>

        <!-- Progress bar -->
        <div class="w-full max-w-lg mb-4 bg-zinc-900 rounded-full h-3 overflow-hidden border border-zinc-800 z-10">
            <div id="progress-bar" class="bg-gradient-to-r from-purple-500 to-fuchsia-500 h-full rounded-full w-0 transition-all ease-linear" style="transition-duration: 1000ms;"></div>
        </div>

        <p class="text-xl text-zinc-400 font-medium z-10" id="status-text">Preparing print data...</p>

        <!-- Error / Retry Section (hidden by default) -->
        <div id="error-section" class="hidden flex flex-col items-center gap-6 mt-8 z-10">
            <div class="bg-red-500/10 border border-red-500/30 rounded-2xl p-6 max-w-md text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-red-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
                <h3 class="text-xl font-bold text-red-400 mb-2">Printer Error</h3>
                <p class="text-zinc-400" id="error-message">Something went wrong with the printer.</p>
            </div>
            <div class="flex gap-4">
                <button id="retry-btn" class="px-8 py-3 bg-gradient-to-r from-purple-600 to-fuchsia-600 text-white font-bold rounded-full hover:scale-105 active:scale-95 transition-transform flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
                    </svg>
                    Retry Print
                </button>
                <button id="skip-btn" class="px-8 py-3 bg-zinc-800 text-white font-bold rounded-full hover:bg-zinc-700 transition-colors border border-zinc-700">
                    Skip & Finish
                </button>
            </div>
        </div>
    </div>

    <script is:inline>
        const BACKEND_URL = 'http://localhost:3000';
        let retryCount = 0;
        const MAX_RETRIES = 3;

        async function triggerPrint() {
            try {
                const res = await fetch(`${BACKEND_URL}/api/hardware/printer/trigger`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ shouldFail: false })
                });
                const data = await res.json();
                return data.success;
            } catch (err) {
                console.error('Printer error:', err);
                return false;
            }
        }

        function showError(msg) {
            document.getElementById('print-title').innerText = 'Print Failed';
            document.getElementById('status-text').classList.add('hidden');
            document.getElementById('error-section').classList.remove('hidden');
            document.getElementById('error-message').innerText = msg;

            // Red LED
            const led = document.getElementById('printer-led');
            led.classList.remove('bg-green-500', 'shadow-[0_0_10px_#22c55e]');
            led.classList.add('bg-red-500', 'shadow-[0_0_10px_#ef4444]');

            // Red progress bar
            document.getElementById('progress-bar').className = 'bg-red-500 h-full rounded-full w-full transition-all';
            
            window.PhotoboxSound.error();
        }

        function resetForRetry() {
            document.getElementById('print-title').innerText = 'Printing Your Memories';
            document.getElementById('status-text').classList.remove('hidden');
            document.getElementById('error-section').classList.add('hidden');
            document.getElementById('progress-bar').className = 'bg-gradient-to-r from-purple-500 to-fuchsia-500 h-full rounded-full w-0 transition-all';
            document.getElementById('progress-bar').style.transitionDuration = '1000ms';
            document.getElementById('progress-bar').style.width = '0%';
            
            const led = document.getElementById('printer-led');
            led.classList.remove('bg-red-500', 'shadow-[0_0_10px_#ef4444]');
            led.classList.add('bg-green-500', 'shadow-[0_0_10px_#22c55e]');

            document.getElementById('photo-paper').style.transform = 'translateY(-100%)';
        }

        async function startPrintingProcess() {
            const progressBar = document.getElementById('progress-bar');
            const statusText = document.getElementById('status-text');
            const photoPaper = document.getElementById('photo-paper');

            // Step 1: Prepare
            statusText.innerText = 'Preparing print data...';
            await new Promise(r => setTimeout(r, 800));
            progressBar.style.width = '15%';
            window.PhotoboxSound.print();

            // Step 2: Send to printer
            statusText.innerText = 'Sending to printer...';
            await new Promise(r => setTimeout(r, 600));
            progressBar.style.width = '30%';

            // Step 3: Printing
            statusText.innerText = 'Printing...';
            progressBar.style.transitionDuration = '3000ms';
            progressBar.style.width = '85%';

            // Start paper animation
            photoPaper.style.transform = 'translateY(15%)';

            // Call backend
            const success = await triggerPrint();

            if (success) {
                // Step 4: Done
                progressBar.style.transitionDuration = '400ms';
                progressBar.style.width = '100%';
                statusText.innerText = '✅ Print Complete!';
                window.PhotoboxSound.success();

                // Clean up stored photos
                localStorage.removeItem('capturedPhotos');

                setTimeout(() => { window.location.href = '/finish'; }, 2000);
            } else {
                retryCount++;
                showError(`Printer failed to respond. (Attempt ${retryCount}/${MAX_RETRIES})`);
            }
        }

        // Retry button
        document.getElementById('retry-btn').addEventListener('click', () => {
            if (retryCount >= MAX_RETRIES) {
                showError('Maximum retries reached. Please contact staff.');
                document.getElementById('retry-btn').disabled = true;
                document.getElementById('retry-btn').classList.add('opacity-50', 'cursor-not-allowed');
                return;
            }
            window.PhotoboxSound.beep(660, 0.1, 0.2);
            resetForRetry();
            setTimeout(startPrintingProcess, 500);
        });

        // Skip button
        document.getElementById('skip-btn').addEventListener('click', () => {
            localStorage.removeItem('capturedPhotos');
            window.location.href = '/finish';
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', startPrintingProcess);
        } else {
            startPrintingProcess();
        }
    </script>
</Layout>
