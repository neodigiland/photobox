---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Payment" hideOverflow={false}>
    <div class="min-h-screen w-full flex flex-col items-center justify-center relative py-6">
        <a href="/select-frame" class="absolute top-0 left-0 p-4 text-zinc-500 hover:text-white transition-colors flex items-center gap-2 text-lg font-medium z-20" id="cancel-btn">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Cancel
        </a>

        <div class="text-center mb-8 z-10">
            <h1 class="text-5xl font-bold mb-3">Complete Payment</h1>
            <p class="text-xl text-zinc-400">Scan the QRIS code using your e-wallet or m-banking</p>
        </div>

        <!-- Payment Card -->
        <div class="bg-white rounded-3xl p-8 max-w-md w-full shadow-[0_0_60px_rgba(255,255,255,0.08)] flex flex-col items-center text-zinc-950 z-10">
            <div class="flex justify-between w-full mb-5 items-center">
                <span class="font-bold text-lg uppercase tracking-widest text-blue-600">QRIS</span>
                <span class="font-bold text-2xl" id="price-display">Rp 0</span>
            </div>

            <!-- QR container -->
            <div id="qr-container" class="w-64 h-64 bg-zinc-100 rounded-2xl flex items-center justify-center mb-5 border border-zinc-200 relative overflow-hidden">
                <div id="loader" class="flex flex-col items-center gap-3 text-zinc-400">
                    <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="font-medium text-sm">Generating QR Code...</span>
                </div>
                <img id="qr-image" src="" alt="QRIS Code" class="hidden w-full h-full object-contain p-2" />
            </div>

            <!-- Timeout Timer -->
            <div class="w-full bg-zinc-100 rounded-full h-2 mb-4 overflow-hidden">
                <div id="timeout-bar" class="h-full bg-gradient-to-r from-blue-500 to-purple-500 rounded-full transition-all duration-1000 ease-linear" style="width: 100%"></div>
            </div>
            <p class="text-sm text-zinc-400 mb-4">
                Expires in <span id="timer-text" class="font-bold text-zinc-600">5:00</span>
            </p>

            <!-- Status Badge -->
            <div class="px-6 py-3 rounded-full font-bold w-full text-center flex items-center justify-center gap-3 transition-all duration-300" id="status-badge">
                <!-- Populated by JS -->
            </div>

            <p class="text-xs text-zinc-400 mt-4 text-center">
                TX: <span id="tx-id" class="font-mono text-zinc-500">—</span>
            </p>
        </div>

        <!-- Dev helper -->
        <div class="mt-8 text-sm text-zinc-600 border border-zinc-800 p-4 rounded-xl max-w-lg text-center backdrop-blur bg-black/20 z-10">
            <strong>Dev Mode:</strong> Simulate payment via terminal:
            <code class="block mt-2 bg-black/40 p-2 rounded text-xs text-zinc-400 break-all" id="dev-cmd">Waiting for TX ID...</code>
        </div>
    </div>

    <script is:inline>
        const BACKEND_URL = 'http://localhost:3000';
        const WS_URL = 'ws://localhost:3000/ws';
        let currentTxId = null;
        let ws = null;
        let pollInterval = null;
        let timerInterval = null;
        let expiresAt = 0;

        const selectedPackage = localStorage.getItem('selectedPackage') || 'basic';
        document.getElementById('price-display').innerText = selectedPackage === 'premium' ? 'Rp 45.000' : 'Rp 30.000';

        function setStatus(type) {
            const badge = document.getElementById('status-badge');
            if (type === 'waiting') {
                badge.className = 'bg-amber-100 text-amber-800 px-6 py-3 rounded-full font-bold w-full text-center flex items-center justify-center gap-3';
                badge.innerHTML = `
                    <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Waiting for payment...`;
            } else if (type === 'success') {
                badge.className = 'bg-green-100 text-green-800 px-6 py-3 rounded-full font-bold w-full text-center flex items-center justify-center gap-3 scale-105 shadow-lg';
                badge.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    Payment Successful!`;
            } else if (type === 'expired') {
                badge.className = 'bg-red-100 text-red-800 px-6 py-3 rounded-full font-bold w-full text-center flex items-center justify-center gap-3';
                badge.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                    </svg>
                    Payment Expired — Redirecting...`;
            } else if (type === 'error') {
                badge.className = 'bg-red-100 text-red-800 px-6 py-3 rounded-full font-bold w-full text-center';
                badge.innerHTML = 'Network Error! Backend offline?';
            }
        }

        function startTimer(expiresInMs) {
            expiresAt = Date.now() + expiresInMs;
            const totalMs = expiresInMs;
            
            timerInterval = setInterval(() => {
                const remaining = Math.max(0, expiresAt - Date.now());
                const mins = Math.floor(remaining / 60000);
                const secs = Math.floor((remaining % 60000) / 1000);
                document.getElementById('timer-text').innerText = `${mins}:${secs.toString().padStart(2, '0')}`;
                document.getElementById('timeout-bar').style.width = `${(remaining / totalMs) * 100}%`;

                // Color warning when under 1 minute
                if (remaining < 60000) {
                    document.getElementById('timeout-bar').className = 'h-full bg-gradient-to-r from-red-500 to-orange-500 rounded-full transition-all duration-1000 ease-linear';
                }

                if (remaining <= 0) {
                    clearInterval(timerInterval);
                    handleExpired();
                }
            }, 1000);
        }

        function handleExpired() {
            cleanup();
            setStatus('expired');
            window.PhotoboxSound.error();
            setTimeout(() => { window.location.href = '/'; }, 3000);
        }

        function handleSuccess() {
            cleanup();
            setStatus('success');
            window.PhotoboxSound.success();
            setTimeout(() => { window.location.href = '/camera'; }, 2000);
        }

        function cleanup() {
            if (pollInterval) clearInterval(pollInterval);
            if (timerInterval) clearInterval(timerInterval);
            if (ws) ws.close();
        }

        function connectWebSocket(txId) {
            ws = new WebSocket(`${WS_URL}?txId=${txId}`);
            ws.onmessage = (event) => {
                const data = JSON.parse(event.data);
                if (data.type === 'PAYMENT_SUCCESS') {
                    handleSuccess();
                } else if (data.type === 'PAYMENT_EXPIRED') {
                    handleExpired();
                }
            };
            ws.onerror = () => console.log('[WS] Error, falling back to polling');
            ws.onclose = () => console.log('[WS] Connection closed');
        }

        // Polling as fallback
        async function pollPaymentStatus() {
            if (!currentTxId) return;
            try {
                const res = await fetch(`${BACKEND_URL}/api/payment-status/${currentTxId}`);
                const data = await res.json();
                if (data.status === 'PAID') handleSuccess();
                else if (data.status === 'EXPIRED') handleExpired();
            } catch (err) { /* silent */ }
        }

        async function initPayment() {
            try {
                const res = await fetch(`${BACKEND_URL}/api/generate-qris?package=${selectedPackage}`);
                const data = await res.json();
                currentTxId = data.transactionId;

                // Show QR (now a real base64 data URL)
                const qrImage = document.getElementById('qr-image');
                qrImage.src = data.qrisUrl;
                qrImage.onload = () => {
                    document.getElementById('loader').classList.add('hidden');
                    qrImage.classList.remove('hidden');
                };

                document.getElementById('tx-id').innerText = currentTxId;
                document.getElementById('dev-cmd').innerText =
                    `Invoke-RestMethod -Uri "http://localhost:3000/api/simulate-payment-success" -Method POST -ContentType "application/json" -Body '{"transactionId": "${currentTxId}"}'`;

                setStatus('waiting');
                startTimer(data.expiresIn);
                connectWebSocket(currentTxId);
                pollInterval = setInterval(pollPaymentStatus, 2000); // Fallback polling
            } catch (err) {
                console.error('Failed:', err);
                setStatus('error');
            }
        }

        // Cancel cleans up
        document.getElementById('cancel-btn').addEventListener('click', () => { cleanup(); });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPayment);
        } else {
            initPayment();
        }
    </script>
</Layout>
