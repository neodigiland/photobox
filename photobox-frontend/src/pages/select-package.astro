---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Select Package">
    <div class="h-full w-full flex flex-col items-center justify-center relative">
        <a href="/" class="absolute top-0 left-0 p-4 text-zinc-500 hover:text-white transition-colors flex items-center gap-2 text-lg font-medium z-20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back
        </a>

        <div class="text-center mb-12 z-10">
            <h1 class="text-5xl font-bold mb-3">Choose Your Package</h1>
            <p class="text-xl text-zinc-400">Select the photo format that fits your style</p>
        </div>

        <div class="flex gap-8 w-full max-w-5xl px-8 z-10">
            <!-- Package 1: Classic Strip -->
            <div class="flex-1 group cursor-pointer select-none" data-package="basic">
                <div class="h-full relative bg-zinc-900/80 backdrop-blur-sm border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-300 group-hover:border-purple-500 group-hover:bg-zinc-900 group-hover:-translate-y-2 group-hover:shadow-[0_20px_60px_rgba(168,85,247,0.2)] flex flex-col">
                    <div class="mb-8 bg-zinc-950 rounded-2xl aspect-[3/4] w-full max-w-[260px] mx-auto flex items-center justify-center p-6 border border-zinc-800/50 shadow-inner">
                        <div class="w-20 h-56 bg-white rounded-sm p-1.5 flex flex-col gap-1.5 shadow-xl">
                            <div class="flex-1 bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                            <div class="flex-1 bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                            <div class="flex-1 bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                            <div class="h-5 bg-white flex items-center justify-center">
                                <div class="w-8 h-1 bg-zinc-200 rounded-full"></div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-auto">
                        <h2 class="text-3xl font-bold mb-1">Paket 1: Strip</h2>
                        <p class="text-zinc-400 mb-6 text-lg">2 Strips • 3 Photos • Custom Frame</p>
                        <div class="flex items-center justify-between">
                            <span class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-fuchsia-400">Rp 30.000</span>
                            <div class="h-12 w-12 rounded-full bg-zinc-800 flex items-center justify-center group-hover:bg-purple-500 group-hover:scale-110 transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Package 2: Premium Grid -->
            <div class="flex-1 group cursor-pointer select-none" data-package="premium">
                <div class="h-full relative bg-zinc-900/80 backdrop-blur-sm border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-300 group-hover:border-fuchsia-500 group-hover:bg-zinc-900 group-hover:-translate-y-2 group-hover:shadow-[0_20px_60px_rgba(217,70,239,0.2)] flex flex-col overflow-hidden">
                    <div class="absolute top-6 -right-12 rotate-45 bg-gradient-to-r from-purple-500 to-fuchsia-500 text-white font-bold py-1.5 px-12 text-sm shadow-lg z-10">
                        POPULAR
                    </div>
                    <div class="mb-8 bg-zinc-950 rounded-2xl aspect-[3/4] w-full max-w-[260px] mx-auto flex items-center justify-center p-6 border border-zinc-800/50 shadow-inner">
                        <div class="w-44 h-44 bg-white rounded-sm p-2 grid grid-cols-2 grid-rows-2 gap-2 shadow-xl">
                            <div class="bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                            <div class="bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                            <div class="bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                            <div class="bg-gradient-to-br from-zinc-200 to-zinc-300 rounded-sm"></div>
                        </div>
                    </div>
                    <div class="mt-auto">
                        <h2 class="text-3xl font-bold mb-1">Paket 2: 4R Penuh</h2>
                        <p class="text-zinc-400 mb-6 text-lg">1 Large Print • 4 Photos • Video Replay</p>
                        <div class="flex items-center justify-between">
                            <span class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 to-pink-400">Rp 45.000</span>
                            <div class="h-12 w-12 rounded-full bg-zinc-800 flex items-center justify-center group-hover:bg-fuchsia-500 group-hover:scale-110 transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        document.querySelectorAll('[data-package]').forEach(card => {
            card.addEventListener('click', () => {
                const pkg = card.dataset.package;
                window.PhotoboxSound.beep(660, 0.1, 0.2);
                localStorage.setItem('selectedPackage', pkg);
                window.location.href = '/select-frame';
            });
        });
    </script>
</Layout>
