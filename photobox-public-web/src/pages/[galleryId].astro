---
import Layout from '../layouts/Layout.astro';

// Explicit opt-in for SSR
export const prerender = false;

const { galleryId } = Astro.params;
let stripUrl = null;
let gifUrl = null;
let rawPhotos = [];
let error = null;

try {
    const getBaseUrl = (filename) => {
        // Cloudflare R2 Public Development URL
        const R2_PUBLIC_URL = 'https://pub-aa94d8b56e1e432aa439e66b27076fee.r2.dev';
        return `${R2_PUBLIC_URL}/${galleryId}/${filename}`;
    };

    const checkExists = async (url) => {
        try {
            const res = await fetch(url, { method: 'HEAD' });
            return res.ok;
        } catch {
            return false;
        }
    };

    // Prepare URLs to check
    const candidateStripPng = getBaseUrl('strip.png');
    const candidateStripJpg = getBaseUrl('strip.jpg');
    const candidateGif = getBaseUrl('animation.gif');
    
    // Check up to 8 photos concurrently
    const photoCandidates = Array.from({ length: 8 }, (_, i) => getBaseUrl(`photo-${i + 1}.jpg`));
    
    const [hasStripPng, hasStripJpg, hasGif, ...photosExist] = await Promise.all([
        checkExists(candidateStripPng),
        checkExists(candidateStripJpg),
        checkExists(candidateGif),
        ...photoCandidates.map(checkExists)
    ]);

    const cacheBuster = `?t=${Date.now()}`;

    if (hasStripPng) stripUrl = candidateStripPng + cacheBuster;
    else if (hasStripJpg) stripUrl = candidateStripJpg + cacheBuster;

    if (hasGif) gifUrl = candidateGif + cacheBuster;

    rawPhotos = photoCandidates
        .filter((_, i) => photosExist[i])
        .map(url => url + cacheBuster);

    if (!stripUrl && !gifUrl && rawPhotos.length === 0) {
        error = "Gallery is empty or not found.";
    }

} catch (err) {
    console.error("Gallery initialization error:", err);
    error = "Could not load gallery";
}
---

<Layout 
    title={`Photobox Gallery - ${galleryId}`}
    description="Your photo strip is ready! Download and share with friends."
    image={stripUrl || undefined}
>
    <main class="w-full min-h-screen flex flex-col items-center justify-center p-6 relative overflow-hidden">
        
        <!-- Ambient BG -->
        <div class="fixed inset-0 pointer-events-none -z-10">
            <div class="absolute top-0 right-0 w-96 h-96 bg-purple-600/10 rounded-full blur-[100px]"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-fuchsia-600/10 rounded-full blur-[100px]"></div>
        </div>

        {error || (!stripUrl && !gifUrl && rawPhotos.length === 0) ? (
            <div class="text-center z-10">
                <h1 class="text-2xl font-bold mb-2 text-white">Gallery Not Found</h1>
                <p class="text-zinc-400">Please check the link and try again.</p>
            </div>
        ) : (
            <div class="w-full max-w-md flex flex-col items-center z-10">
                
                <h1 class="text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-fuchsia-400 mb-8 tracking-tight">
                    Your Memories ✨
                </h1>

                {/* --- STRIP SECTION --- */}
                {stripUrl && (
                    <div class="w-full mb-8">
                        <div class="flex items-center justify-between mb-3 px-2">
                            <h2 class="text-lg font-bold text-white">Photo Strip</h2>
                            <a href={stripUrl} download={`photobox-strip-${galleryId}.png`} target="_blank" class="text-purple-400 hover:text-purple-300 text-sm font-bold flex items-center gap-1 bg-purple-500/10 px-3 py-1.5 rounded-full">⬇️ Save</a>
                        </div>
                        <div class="bg-white/5 border border-white/10 rounded-3xl p-4 backdrop-blur-md shadow-2xl tilt-card relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent pointer-events-none"></div>
                            <img src={stripUrl} alt="Photo Strip" class="w-full rounded-2xl shadow-inner border border-white/10 select-none" />
                        </div>
                    </div>
                )}
                
                {/* --- GIF SECTION --- */}
                {gifUrl && (
                    <div class="w-full mb-10">
                        <div class="flex items-center justify-between mb-3 px-2">
                            <h2 class="text-lg font-bold text-white">Live Animation (GIF)</h2>
                            <a href={gifUrl} download={`photobox-gif-${galleryId}.gif`} target="_blank" class="text-pink-400 hover:text-pink-300 text-sm font-bold flex items-center gap-1 bg-pink-500/10 px-3 py-1.5 rounded-full">⬇️ Save</a>
                        </div>
                        <div class="bg-white/5 border border-pink-500/20 rounded-3xl p-2 backdrop-blur-md shadow-[0_0_40px_rgba(219,39,119,0.2)] relative overflow-hidden">
                            <img src={gifUrl} alt="Animated GIF" class="w-full rounded-2xl shadow-inner border border-white/10 object-cover aspect-square" />
                        </div>
                    </div>
                )}

                {/* --- RAW PHOTOS SECTION --- */}
                {rawPhotos.length > 0 && (
                     <div class="w-full mb-8">
                        <h2 class="text-lg font-bold text-white mb-3 px-2">Individual Shots</h2>
                        <div class="grid grid-cols-2 gap-4">
                            {rawPhotos.map((photo, i) => (
                                <div class="bg-white/5 border border-white/10 rounded-xl p-2 backdrop-blur-md">
                                    <img src={photo} alt={`Raw Photo ${i+1}`} class="w-full aspect-[4/3] object-cover rounded-lg mb-2" />
                                    <a href={photo} download={`photobox-${i+1}.jpg`} target="_blank" class="block text-center text-xs font-bold text-zinc-300 bg-white/10 hover:bg-white/20 py-2 rounded-md transition-colors">⬇️ Download</a>
                                </div>
                            ))}
                        </div>
                     </div>
                )}

                <!-- Actions -->
                <div class="w-full space-y-4 mt-4">
                    <button class="w-full py-4 px-6 bg-zinc-800/40 hover:bg-zinc-800 border border-zinc-700/50 hover:border-zinc-500 rounded-2xl font-semibold text-zinc-300 transition-all flex justify-center items-center gap-2 backdrop-blur-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                        Share to IG Story
                    </button>
                </div>
                
                <div class="mt-12 text-center text-zinc-600 text-sm font-medium">
                    <p>Photobox Studio &copy; {new Date().getFullYear()}</p>
                </div>
            </div>
        )}
    </main>
</Layout>

<style>
/* Smooth entrance animation */
main > div {
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>
