---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Select Frame" hideOverflow={false}>
    <div class="min-h-screen w-full flex flex-col items-center justify-start pt-6 pb-12 relative">
        <a href="/select-package" class="absolute top-0 left-0 p-4 text-zinc-500 hover:text-white transition-colors flex items-center gap-2 text-lg font-medium z-20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back
        </a>

        <div class="text-center mb-6 z-10 mt-8">
            <h1 class="text-4xl font-bold mb-2">Pick Your Frame</h1>
            <p class="text-lg text-zinc-400">This is exactly how your print will look</p>
        </div>

        <!-- Loading state -->
        <div id="loading-frames" class="flex items-center gap-3 text-zinc-400 py-20 z-10">
            <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Loading frames...
        </div>

        <!-- Frame cards -->
        <div class="hidden flex-wrap gap-5 w-full max-w-6xl px-6 z-10 justify-center" id="frame-grid">
            <!-- Populated dynamically -->
        </div>

        <!-- Confirm Button -->
        <button id="confirm-btn" class="mt-8 px-12 py-4 bg-zinc-800 text-zinc-500 font-bold text-xl rounded-full cursor-not-allowed transition-all duration-300 z-10" disabled>
            Select a Frame to Continue
        </button>
    </div>

    <script src="/js/strip-renderer.js" is:inline></script>
    <script is:inline>
        const BACKEND_URL = 'http://localhost:3000';
        const selectedPackage = localStorage.getItem('selectedPackage') || 'basic';
        const totalPhotos = selectedPackage === 'premium' ? 4 : 3;
        let selectedFrameId = null;
        const confirmBtn = document.getElementById('confirm-btn');

        async function loadFrames() {
            try {
                const res = await fetch(`${BACKEND_URL}/api/frames`);
                const frames = await res.json();
                renderFrameCards(frames);
            } catch (err) {
                console.error('Failed to load frames:', err);
                document.getElementById('loading-frames').innerHTML = '<p class="text-red-400">Failed to load frames. Is the backend running?</p>';
            }
        }

        async function renderFrameCards(frames) {
            const grid = document.getElementById('frame-grid');
            grid.innerHTML = '';
            grid.style.display = 'flex';
            document.getElementById('loading-frames').style.display = 'none';

            for (const frame of frames) {
                const card = document.createElement('div');
                card.className = 'frame-card group cursor-pointer select-none';
                card.dataset.frameId = frame.id;
                card.style.width = '220px';

                card.innerHTML = `
                    <div class="relative bg-zinc-900 border-2 border-zinc-800 rounded-2xl p-4 transition-all duration-300 group-hover:border-purple-500/50 group-hover:-translate-y-1 group-hover:shadow-[0_10px_30px_rgba(168,85,247,0.15)] flex flex-col items-center h-full" data-inner>
                        <div class="w-full flex items-center justify-center mb-3 overflow-hidden rounded-lg" style="max-height: 320px;">
                            <canvas data-canvas class="rounded-lg shadow-lg"></canvas>
                        </div>
                        <span class="font-semibold text-base">${frame.name}</span>
                        <span class="text-xs text-zinc-500 mb-1">${frame.subtitle}</span>
                        ${!frame.isDefault ? '<span class="text-[10px] text-purple-400 font-bold">CUSTOM</span>' : ''}
                        <div class="absolute top-3 right-3 w-6 h-6 rounded-full border-2 border-zinc-700 flex items-center justify-center transition-all" data-check></div>
                    </div>
                `;

                grid.appendChild(card);

                // Render preview on canvas at a smaller scale
                const canvas = card.querySelector('[data-canvas]');
                const placeholders = new Array(totalPhotos).fill(null);
                await StripRenderer.render(canvas, placeholders, frame, selectedPackage);

                // Scale canvas down to fit card — override the inline styles set by renderer
                const originalW = parseInt(canvas.style.width);
                const originalH = parseInt(canvas.style.height);
                const maxH = 300;
                if (originalH > maxH) {
                    const scale = maxH / originalH;
                    canvas.style.width = Math.round(originalW * scale) + 'px';
                    canvas.style.height = Math.round(originalH * scale) + 'px';
                }

                // Click handler
                card.addEventListener('click', () => selectFrame(frame.id, card));
            }
        }

        function selectFrame(frameId, card) {
            window.PhotoboxSound.beep(550, 0.08, 0.15);

            // Deselect all
            document.querySelectorAll('.frame-card').forEach(c => {
                const inner = c.querySelector('[data-inner]');
                inner.classList.remove('border-purple-500', 'ring-2', 'ring-purple-500/30', 'shadow-[0_10px_30px_rgba(168,85,247,0.25)]');
                const check = c.querySelector('[data-check]');
                check.innerHTML = '';
                check.classList.remove('border-purple-500', 'bg-purple-500');
                check.classList.add('border-zinc-700');
            });

            // Select this one
            selectedFrameId = frameId;
            const inner = card.querySelector('[data-inner]');
            inner.classList.add('border-purple-500', 'ring-2', 'ring-purple-500/30', 'shadow-[0_10px_30px_rgba(168,85,247,0.25)]');
            const check = card.querySelector('[data-check]');
            check.classList.remove('border-zinc-700');
            check.classList.add('border-purple-500', 'bg-purple-500');
            check.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>`;

            // Enable button
            confirmBtn.disabled = false;
            confirmBtn.className = 'mt-8 px-12 py-4 bg-gradient-to-r from-purple-600 to-fuchsia-600 text-white font-bold text-xl rounded-full cursor-pointer transition-all duration-300 z-10 hover:scale-105 active:scale-95 shadow-[0_0_30px_rgba(168,85,247,0.3)]';
            confirmBtn.innerText = 'Continue to Payment →';
        }

        confirmBtn.addEventListener('click', () => {
            if (!selectedFrameId) return;
            window.PhotoboxSound.beep(880, 0.1, 0.2);
            localStorage.setItem('selectedFrame', selectedFrameId);
            window.location.href = '/payment';
        });

        loadFrames();
    </script>
</Layout>
