---
import '../styles/global.css';

interface Props {
    title: string;
    hideOverflow?: boolean;
}

const { title, hideOverflow = true } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Photobox Studio — Self-service photo booth" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Photobox</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    </head>
    <body class:list={[
        "bg-zinc-950 text-white font-['Outfit'] min-h-screen flex flex-col selection:bg-purple-500 selection:text-white",
        hideOverflow && "overflow-hidden"
    ]}>
        <main class="flex-grow flex flex-col items-center justify-center relative w-full h-full p-8">
            <slot />
        </main>

        <!-- Global Sound Utility -->
        <script is:inline>
            window.PhotoboxSound = {
                _ctx: null,
                _getCtx() {
                    if (!this._ctx) this._ctx = new (window.AudioContext || window.webkitAudioContext)();
                    return this._ctx;
                },
                beep(freq = 880, duration = 0.15, vol = 0.3) {
                    const ctx = this._getCtx();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.frequency.value = freq;
                    osc.type = 'sine';
                    gain.gain.setValueAtTime(vol, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + duration);
                },
                countdownTick() { this.beep(660, 0.1, 0.25); },
                countdownFinal() { this.beep(1200, 0.3, 0.4); },
                shutter() {
                    // White noise burst for shutter
                    const ctx = this._getCtx();
                    const bufferSize = ctx.sampleRate * 0.08;
                    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
                    const noise = ctx.createBufferSource();
                    noise.buffer = buffer;
                    const gain = ctx.createGain();
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
                    noise.connect(gain);
                    gain.connect(ctx.destination);
                    noise.start();
                },
                success() { this.beep(523, 0.1, 0.2); setTimeout(() => this.beep(659, 0.1, 0.2), 120); setTimeout(() => this.beep(784, 0.2, 0.3), 240); },
                error() { this.beep(200, 0.3, 0.3); setTimeout(() => this.beep(150, 0.4, 0.3), 300); },
                print() { this.beep(440, 0.05, 0.1); }
            };
        </script>
        <!-- Global Idle Timeout -->
        <script is:inline>
            (function() {
                const IDLE_MS = 60000;
                const EXEMPT = ['/camera', '/printing', '/admin'];
                let timer = null;

                function resetIdle() {
                    if (timer) clearTimeout(timer);
                    timer = setTimeout(() => {
                        const path = window.location.pathname;
                        if (!EXEMPT.includes(path)) {
                            localStorage.clear();
                            window.location.href = '/';
                        }
                    }, IDLE_MS);
                }

                ['touchstart', 'mousemove', 'click'].forEach(e => {
                    document.addEventListener(e, resetIdle, { passive: true });
                });

                resetIdle();
            })();
        </script>
    </body>
</html>
