---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You!" hideOverflow={false}>
    <div class="min-h-screen w-full flex flex-col items-center justify-start pt-8 pb-12 relative select-none text-center">
        <!-- Background effect -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute top-1/3 left-1/3 w-80 h-80 bg-green-600/10 rounded-full blur-[120px] animate-pulse"></div>
            <div class="absolute bottom-1/3 right-1/3 w-60 h-60 bg-purple-600/15 rounded-full blur-[100px] animate-pulse" style="animation-delay: 1s;"></div>
        </div>

        <!-- Checkmark -->
        <div class="w-24 h-24 bg-green-500 rounded-full flex items-center justify-center mb-6 shadow-[0_0_50px_rgba(34,197,94,0.4)] z-10 animate-bounce" style="animation-duration: 2s; animation-iteration-count: 3;">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-5xl font-bold mb-3 z-10">Thank You!</h1>
        <p class="text-xl text-zinc-400 max-w-lg mb-8 z-10">
            Please take your printed photos from the slot below 📸
        </p>

        <!-- Download QR Section -->
        <div class="bg-zinc-900/80 backdrop-blur-sm border border-zinc-800 rounded-2xl p-6 max-w-sm w-full z-10 mb-6" id="download-section">
            <h3 class="text-lg font-bold mb-1 text-white flex items-center justify-center gap-2">
                📲 Download Your Photos
            </h3>
            <p class="text-sm text-zinc-400 mb-4">Scan with your phone to save all photos</p>

            <!-- QR Code -->
            <div class="bg-white rounded-xl p-3 inline-block mb-4 shadow-lg" id="qr-container">
                <div id="qr-loading" class="w-48 h-48 flex items-center justify-center text-zinc-400">
                    <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
                <img id="qr-image" src="" alt="Download QR Code" class="hidden w-48 h-48 object-contain" />
            </div>

            <!-- Download URL text -->
            <p class="text-xs text-zinc-500 font-mono break-all px-4 mb-3" id="download-url">—</p>

            <!-- What's included -->
            <div class="flex justify-center gap-4 text-xs text-zinc-400">
                <span class="flex items-center gap-1">📷 Raw photos</span>
                <span class="text-zinc-700">•</span>
                <span class="flex items-center gap-1">🖼️ Photo strip</span>
            </div>
        </div>

        <!-- No gallery fallback -->
        <div class="hidden bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 max-w-sm w-full z-10 mb-6" id="no-gallery-section">
            <p class="text-zinc-400 text-sm">Digital download not available for this session</p>
        </div>

        <!-- Social Share -->
        <div class="bg-zinc-900/80 backdrop-blur-sm border border-zinc-800 rounded-2xl p-5 max-w-sm w-full z-10 mb-8">
            <p class="text-base text-zinc-300 mb-3 font-medium">Share your experience!</p>
            <div class="flex gap-3 justify-center">
                <div class="w-11 h-11 bg-gradient-to-br from-pink-500 via-red-500 to-yellow-400 rounded-xl flex items-center justify-center text-white shadow-lg hover:scale-110 transition-transform cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                </div>
                <div class="w-11 h-11 bg-black rounded-xl flex items-center justify-center text-white shadow-lg hover:scale-110 transition-transform cursor-pointer border border-zinc-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                </div>
                <div class="w-11 h-11 bg-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg hover:scale-110 transition-transform cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                </div>
            </div>
            <p class="text-xs text-zinc-500 mt-3">Tag us @photoboxstudio</p>
        </div>

        <p class="text-lg text-zinc-500 z-10">
            Returning to home screen in <span id="countdown" class="font-bold text-white text-2xl mx-1">20</span> seconds...
        </p>
    </div>

    <script is:inline>
        // ─── COUNTDOWN (always runs first, no dependencies) ─────
        let secondsLeft = 20;
        const countdownEl = document.getElementById('countdown');
        const countdownInterval = setInterval(function() {
            secondsLeft--;
            if (countdownEl) countdownEl.innerText = secondsLeft;
            if (secondsLeft <= 0) {
                clearInterval(countdownInterval);
                window.location.href = '/';
            }
        }, 1000);

        // ─── GALLERY QR (wrapped in try-catch) ──────────────────
        try {
            const galleryQR = localStorage.getItem('galleryQR');
            const galleryURL = localStorage.getItem('galleryURL');

            if (galleryQR && galleryURL) {
                document.getElementById('qr-loading').classList.add('hidden');
                const qrImg = document.getElementById('qr-image');
                qrImg.src = galleryQR;
                qrImg.classList.remove('hidden');
                document.getElementById('download-url').innerText = galleryURL;
            } else {
                document.getElementById('download-section').classList.add('hidden');
                document.getElementById('no-gallery-section').classList.remove('hidden');
            }
        } catch(e) { console.warn('Gallery QR error:', e); }

        // ─── CLEANUP (wrapped in try-catch) ─────────────────────
        try {
            localStorage.removeItem('selectedPackage');
            localStorage.removeItem('selectedFrame');
            localStorage.removeItem('capturedPhotos');
            localStorage.removeItem('galleryId');
            localStorage.removeItem('galleryQR');
            localStorage.removeItem('galleryURL');
        } catch(e) { console.warn('Cleanup error:', e); }

        // ─── SOUND (wrapped in try-catch) ────────────────────────
        try {
            if (window.PhotoboxSound) window.PhotoboxSound.success();
        } catch(e) { console.warn('Sound error:', e); }
    </script>
</Layout>
