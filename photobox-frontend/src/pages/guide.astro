---
import Layout from '../layouts/Layout.astro';
---

<Layout title="How It Works">
    <div class="h-full w-full flex flex-col items-center justify-center relative select-none overflow-hidden">

        <!-- Background Orbs -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] bg-purple-600/15 rounded-full blur-[160px] animate-pulse"></div>
            <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-fuchsia-600/10 rounded-full blur-[140px] animate-pulse" style="animation-delay: 1.5s;"></div>
        </div>

        <!-- Header -->
        <div class="text-center mb-10 z-10">
            <p class="text-sm uppercase tracking-[4px] text-purple-400 font-semibold mb-3 opacity-80">AnyPic Photobox</p>
            <h1 class="text-5xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-fuchsia-400">
                Cara Foto di AnyPic
            </h1>
            <p class="text-lg text-zinc-400 mt-3 font-light">Ikuti langkah mudah berikut ini</p>
        </div>

        <!-- Steps Container -->
        <div class="grid grid-cols-7 gap-3 max-w-6xl w-full px-6 z-10" id="steps-grid">

            <!-- Step 1 -->
            <div class="step-card group" data-step="1" style="animation-delay: 0.1s;">
                <div class="step-icon-wrap" style="--step-color: #818cf8;">
                    <div class="step-number">1</div>
                    <div class="step-icon">📦</div>
                </div>
                <h3 class="step-title">Pilih Paket</h3>
                <p class="step-desc">Pilih paket foto Strip atau 4R sesuai keinginan</p>
            </div>

            <!-- Connector -->
            <div class="step-connector" style="animation-delay: 0.2s;">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-zinc-700"><path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </div>

            <!-- Step 2 -->
            <div class="step-card group" data-step="2" style="animation-delay: 0.3s;">
                <div class="step-icon-wrap" style="--step-color: #a78bfa;">
                    <div class="step-number">2</div>
                    <div class="step-icon">💳</div>
                </div>
                <h3 class="step-title">Pembayaran</h3>
                <p class="step-desc">Scan QRIS dan lakukan pembayaran</p>
            </div>

            <!-- Connector -->
            <div class="step-connector" style="animation-delay: 0.4s;">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-zinc-700"><path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </div>

            <!-- Step 3 -->
            <div class="step-card group" data-step="3" style="animation-delay: 0.5s;">
                <div class="step-icon-wrap" style="--step-color: #c084fc;">
                    <div class="step-number">3</div>
                    <div class="step-icon">🖼️</div>
                </div>
                <h3 class="step-title">Pilih Frame</h3>
                <p class="step-desc">Pilih template frame foto favorit kamu</p>
            </div>

            <!-- Connector -->
            <div class="step-connector" style="animation-delay: 0.6s;">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-zinc-700"><path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </div>

            <!-- Step 4 -->
            <div class="step-card group" data-step="4" style="animation-delay: 0.7s;">
                <div class="step-icon-wrap" style="--step-color: #e879f9;">
                    <div class="step-number">4</div>
                    <div class="step-icon">📸</div>
                </div>
                <h3 class="step-title">Sesi Foto</h3>
                <p class="step-desc">Berpose dan foto akan diambil otomatis</p>
            </div>

            <!-- Connector -->
            <div class="step-connector" style="animation-delay: 0.8s;">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-zinc-700"><path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </div>

            <!-- Step 5 -->
            <div class="step-card group" data-step="5" style="animation-delay: 0.9s;">
                <div class="step-icon-wrap" style="--step-color: #f472b6;">
                    <div class="step-number">5</div>
                    <div class="step-icon">✨</div>
                </div>
                <h3 class="step-title">Filter</h3>
                <p class="step-desc">Tambahkan filter untuk mempercantik foto</p>
            </div>

            <!-- Connector -->
            <div class="step-connector" style="animation-delay: 1.0s;">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-zinc-700"><path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </div>

            <!-- Step 6 -->
            <div class="step-card group" data-step="6" style="animation-delay: 1.1s;">
                <div class="step-icon-wrap" style="--step-color: #fb7185;">
                    <div class="step-number">6</div>
                    <div class="step-icon">📱</div>
                </div>
                <h3 class="step-title">Scan QR</h3>
                <p class="step-desc">Scan QR code untuk download soft file foto</p>
            </div>

            <!-- Connector -->
            <div class="step-connector" style="animation-delay: 1.2s;">
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-zinc-700"><path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
            </div>

            <!-- Step 7 -->
            <div class="step-card group" data-step="7" style="animation-delay: 1.3s;">
                <div class="step-icon-wrap" style="--step-color: #f87171;">
                    <div class="step-number">7</div>
                    <div class="step-icon">🖨️</div>
                </div>
                <h3 class="step-title">Print</h3>
                <p class="step-desc">Minta operator untuk print hasil foto kamu</p>
            </div>

        </div>

        <!-- CTA Button -->
        <button id="start-btn" class="group relative mt-12 px-14 py-5 bg-white text-zinc-950 font-bold text-xl rounded-full overflow-hidden transition-all duration-300 transform hover:scale-105 active:scale-95 shadow-[0_0_40px_rgba(255,255,255,0.15)] z-10">
            <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/50 to-transparent -translate-x-full animate-[shimmer_2.5s_infinite]"></div>
            <span class="relative flex items-center gap-3">
                Mulai Sekarang
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </span>
        </button>

        <!-- Version -->
        <div class="absolute bottom-5 text-zinc-700 text-xs font-mono z-10">Swipe or Tap to continue</div>
    </div>

    <script is:inline>
        document.getElementById('start-btn').addEventListener('click', () => {
            window.PhotoboxSound.beep(880, 0.1, 0.2);
            window.location.href = '/select-package';
        });
    </script>
</Layout>

<style>
    @keyframes shimmer {
        100% { transform: translateX(100%); }
    }

    @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .step-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px 8px;
        border-radius: 20px;
        background: rgba(24, 24, 27, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(63, 63, 70, 0.4);
        transition: all 0.3s ease;
        opacity: 0;
        animation: fadeSlideUp 0.6s ease forwards;
    }

    .step-card:hover {
        border-color: rgba(168, 85, 247, 0.4);
        background: rgba(30, 30, 36, 0.8);
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(168, 85, 247, 0.08);
    }

    .step-icon-wrap {
        position: relative;
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(24,24,27,0.9), rgba(39,39,42,0.9));
        border: 1px solid rgba(63, 63, 70, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        transition: all 0.3s ease;
    }

    .step-card:hover .step-icon-wrap {
        border-color: var(--step-color, #a78bfa);
        box-shadow: 0 0 20px color-mix(in srgb, var(--step-color, #a78bfa) 20%, transparent);
    }

    .step-number {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--step-color, #a78bfa);
        color: white;
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .step-icon {
        font-size: 28px;
        line-height: 1;
    }

    .step-title {
        font-size: 14px;
        font-weight: 700;
        color: #e4e4e7;
        margin-bottom: 4px;
    }

    .step-desc {
        font-size: 11px;
        color: #71717a;
        line-height: 1.4;
    }

    .step-connector {
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        animation: fadeSlideUp 0.6s ease forwards;
    }
</style>
